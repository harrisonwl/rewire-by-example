// Per-cycle step: outputs # next register values.
rw_step : [14] -> [9] -> [16]
rw_step st i = (take`{1} (drop`{6} s5)) # ((take`{1} (drop`{7} s5)) # ((take`{4} (drop`{8} s5)) # ((take`{1} (drop`{12} s5)) # ((take`{1} (drop`{13} s5)) # (drop`{14} s5)))))
  where
    s0 : [4]
    s0 = take`{4} st
    s1 : [1]
    s1 = take`{1} (drop`{4} st)
    s2 : [1]
    s2 = take`{1} (drop`{5} st)
    s3 : [8]
    s3 = drop`{6} st
    s4 : [9]
    s4 = i
    s5 : [22]
    s5 = rw__Pure_dispatch (s0 # (s1 # (s2 # s3))) s4

// Device: top_level
// Inputs, MSB-first: __in0 : [9]
// Outputs, MSB-first: __out0 : [1], __out1 : [1]
rw_device : {n} (fin n) => [n][9] -> [n][2]
rw_device ins = outs
  where
    rs : [n][16]
    rs = [rw_step st i | st <- sts | i <- ins]
    sts : [1 + n][14]
    sts = [0b10001000000000] # [drop`{2} r | r <- rs]
    outs : [n][2]
    outs = [take`{2} r | r <- rs]