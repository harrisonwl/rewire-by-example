// Per-cycle step: outputs # next register values.
rw_step : [32] -> [10] -> [34]
rw_step st i = (take`{1} (drop`{31} s3)) # ((take`{1} (drop`{32} s3)) # ((take`{1} (drop`{33} s3)) # (drop`{34} s3)))
  where
    s0 : [1]
    s0 = take`{1} st
    s1 : [31]
    s1 = drop`{1} st
    s2 : [10]
    s2 = i
    s3 : [65]
    s3 = rw__Pure_dispatch (s0 # s1) s2

// Device: top_level
// Inputs, MSB-first: __in0 : [10]
// Outputs, MSB-first: __out0 : [1], __out1 : [1]
rw_device : {n} (fin n) => [n][10] -> [n][2]
rw_device ins = outs
  where
    rs : [n][34]
    rs = [rw_step st i | st <- sts | i <- ins]
    sts : [1 + n][32]
    sts = [0x80000002] # [drop`{2} r | r <- rs]
    outs : [n][2]
    outs = [take`{2} r | r <- rs]