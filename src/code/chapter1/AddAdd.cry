// Generated by rwc from device: top_level.
// rw_device maps a sequence of per-cycle inputs to per-cycle outputs.

module top_level where

// Helpers implementing ReWire Hyle primitive semantics.
rw'resize : {m, n} (fin m, fin n) => [n] -> [m]
rw'resize x = drop`{n} ((zero : [m]) # x)

rw'repl : {n, w} (fin n, fin w) => [w] -> [n * w]
rw'repl x = join (repeat`{n} x)

rw'parity : {n} (fin n) => [n] -> Bit
rw'parity x = foldr (^) False x

rw'sext : {m, n} (fin m, fin n, n >= 1) => [n] -> [m]
rw'sext x = if x @ 0 then ~ (rw'resize (~ x)) else rw'resize x

// $Pure.dispatch
rw__Pure_dispatch : [9] -> [8] -> [18]
rw__Pure_dispatch x0 x1 = if (take`{1} x0) == 0b1 then (rw__LL_Pure_dispatch2 x1) else (rw__LL_Pure_dispatch x1 (drop`{1} x0))

// $LL.Main.addadd3
rw__LL_Main_addadd3 : [8] -> [18]
rw__LL_Main_addadd3 x0 = 0b0000000000 # x0

// $LL.Pure.dispatch2
rw__LL_Pure_dispatch2 : [8] -> [18]
rw__LL_Pure_dispatch2 x0 = rw_Main_addadd1 x0

// $LL.Main.addadd2
rw__LL_Main_addadd2 : [8] -> [8] -> [18]
rw__LL_Main_addadd2 x0 x1 = rw__LL_Main_addadd1 x0 x1

// $LL.Main.addadd1
rw__LL_Main_addadd1 : [8] -> [8] -> [18]
rw__LL_Main_addadd1 x0 x1 = 0b1 # ((x0 + x1) # 0b100000000)

// $LL.Pure.dispatch1
rw__LL_Pure_dispatch1 : [8] -> [8] -> [18]
rw__LL_Pure_dispatch1 x0 x1 = rw__LL_Main_addadd2 x1 x0

// Main.addadd1
rw_Main_addadd1 : [8] -> [18]
rw_Main_addadd1 x0 = rw__LL_Main_addadd x0

// $LL.Main.addadd
rw__LL_Main_addadd : [8] -> [18]
rw__LL_Main_addadd x0 = rw__LL_Main_addadd3 x0

// $LL.Pure.dispatch
rw__LL_Pure_dispatch : [8] -> [8] -> [18]
rw__LL_Pure_dispatch x0 x1 = rw__LL_Pure_dispatch1 x0 x1

// Per-cycle step: outputs # next register values.
rw_step : [9] -> [8] -> [18]
rw_step st i = (take`{1} s2) # ((take`{8} (drop`{1} s2)) # (drop`{9} s2))
  where
    s0 : [9]
    s0 = st
    s1 : [8]
    s1 = i
    s2 : [18]
    s2 = rw__Pure_dispatch s0 s1

// Device: top_level
// Inputs, MSB-first: __in0 : [8]
// Outputs, MSB-first: __out0 : [1], __out1 : [8]
rw_device : {n} (fin n) => [n][8] -> [n][9]
rw_device ins = outs
  where
    rs : [n][18]
    rs = [rw_step st i | st <- sts | i <- ins]
    sts : [1 + n][9]
    sts = [0b000000000] # [drop`{9} r | r <- rs]
    outs : [n][9]
    outs = [take`{9} r | r <- rs]